{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\Users\\\\Administrator\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\Microsoft.PowerShell_8wekyb3d8bbwe\\\\pwsh.exe\" -Command 'Get-Content infrastructure/stages/frontend/interactions/testing.py -TotalCount 80; Get-Content tests/test_portability.py | Select-Object -Skip 160 -First 18; Get-Content infrastructure/utils/processes.py -TotalCount 180'","aggregated_output":"\"\"\"Real-app browser checks and executable E2E RED/GREEN gates.\"\"\"\r\n\r\nfrom hashlib import sha256\r\nimport os\r\nfrom pathlib import Path\r\nimport re\r\nfrom tempfile import TemporaryDirectory\r\n\r\nfrom infrastructure.stages.frontend.interactions.e2e_runtime import RUNNER\r\nfrom infrastructure.stages.frontend.ui.testing import FrontendChecks, parse_playwright_result, require_green, require_red\r\nfrom infrastructure.shared.project.entrypoints import selected_path\r\n\r\n\r\ndef test_path(rid, output=None):\r\n    \"\"\"Return a safe, stable E2E spec path for one requirement.\"\"\"\r\n    chosen = selected_path(output, \"e2e_test\", rid) if output is not None else None\r\n    if chosen:\r\n        return chosen\r\n    slug = rid if re.fullmatch(r\"[A-Za-z][A-Za-z0-9_-]*\", rid) else \"requirement-\" + sha256(rid.encode()).hexdigest()[:12]\r\n    return f\"frontend/tests/e2e/{slug}.spec.ts\"\r\n\r\n\r\ndef require_behavioral_red(result):\r\n    \"\"\"Require observable behavioral assertion failures and reject server, browser, or runtime failures.\"\"\"\r\n    try:\r\n        require_red(result)\r\n    except ValueError as error:\r\n        raise ValueError(f\"Expected behavioral assertion RED, not server/browser/runtime failure: {result}\") from error\r\n\r\n\r\nclass E2EChecks(FrontendChecks):\r\n    \"\"\"Real-app Playwright checks with isolated test data .\"\"\"\r\n    def __init__(self, output, maximum=5):\r\n        \"\"\"Reuse frontend checks with a longer real-server timeout and an enforced per-requirement test budget.\"\"\"\r\n        super().__init__(output, timeout=300)\r\n        self.maximum = maximum\r\n\r\n    def typecheck(self, files, full_source=True):\r\n        \"\"\"Compile UI and E2E tests, optionally restricting application sources during test generation.\"\"\"\r\n        return super().typecheck(files, test_roots=(\"frontend/tests/ui\", \"frontend/tests/e2e\"),\r\n            source_files=(\"src/**/*.ts\", \"src/**/*.tsx\") if full_source else (\"src/main.tsx\",))\r\n\r\n    def tests(self, files):\r\n        \"\"\"Run only selected E2E specs with an owned temporary database, clean it up, .\"\"\"\r\n        if not files:\r\n            raise ValueError(\"Do not run empty E2E suites\")\r\n        for relative in files:\r\n            if not (self.output / relative).resolve().is_relative_to(self.output / \"frontend/tests/e2e\"):\r\n                raise ValueError(\"Run only the selected E2E test suites\")\r\n        # The Node runner creates a child directory here. Python also removes\r\n        # it after timeout/interruption, so test databases never persist.\r\n        with TemporaryDirectory(prefix=\"arc-e2e-owner-\") as temporary:\r\n            env = {**os.environ, \"ARC_E2E_TEMP_ROOT\": temporary}\r\n            print(\"Playwright E2E | real backend + isolated database | \" + \", \".join(files), flush=True)\r\n            result = self.execute([RUNNER, *files], env=env)\r\n        result = parse_playwright_result(result, include_files=True)\r\n        return result\r\n            self.assertEqual(result[\"returncode\"], 0)\r\n            self.assertEqual(json.loads(result[\"stdout\"]), [value, str(directory), \"utf-8\"])\r\n\r\n    def test_timeout_stops_descendants(self):\r\n        \"\"\"A timed-out parent must not leave a heartbeat-writing child alive.\"\"\"\r\n        with TemporaryDirectory(prefix=\"arc process \") as temporary:\r\n            directory = Path(temporary)\r\n            marker = directory / \"heartbeat\"\r\n            child = \"import time,pathlib; p=pathlib.Path('heartbeat');\\nwhile True:\\n p.open('a').write('x'); time.sleep(.03)\"\r\n            parent = \"import subprocess,sys,time; subprocess.Popen([sys.executable,'-c',sys.argv[1]]); time.sleep(60)\"\r\n            with self.assertRaises(subprocess.TimeoutExpired):\r\n                processes.capture_process([sys.executable, \"-c\", parent, child], cwd=directory, timeout=2)\r\n            self.assertTrue(marker.is_file())\r\n            before = marker.read_bytes()\r\n            time.sleep(.2)\r\n            self.assertEqual(marker.read_bytes(), before)\r\n\r\n\r\n\"\"\"Cross-platform process startup, UTF-8 output, npm resolution, and owned-tree cleanup.\"\"\"\r\n\r\nimport os\r\nfrom pathlib import Path\r\nimport shutil\r\nimport signal\r\nimport subprocess\r\n\r\nWINDOWS = os.name == \"nt\"\r\n\r\n\r\ndef child_environment(overrides=None) -> dict:\r\n    \"\"\"Keep inherited settings while making Python child output consistently UTF-8.\"\"\"\r\n    return {**os.environ, **(overrides or {}), \"PYTHONUTF8\": \"1\", \"PYTHONIOENCODING\": \"utf-8\"}\r\n\r\n\r\ndef process_options() -> dict:\r\n    \"\"\"Create an owned process group using the host platform's supported API.\"\"\"\r\n    if WINDOWS:\r\n        return {\"creationflags\": getattr(subprocess, \"CREATE_NEW_PROCESS_GROUP\", 0x00000200)}\r\n    return {\"start_new_session\": True}\r\n\r\n\r\ndef start_process(command, *, cwd, env=None, **options):\r\n    \"\"\"Launch an argument list without shell interpolation, preserving spaces and Unicode paths.\"\"\"\r\n    return subprocess.Popen([str(part) for part in command], cwd=cwd,\r\n        env=child_environment(env), **process_options(), **options)\r\n\r\n\r\ndef stop_process(process) -> None:\r\n    \"\"\"Stop only the owned process tree on interruption/timeout, including browser/server children.\"\"\"\r\n    if WINDOWS:\r\n        # Killing node.exe alone leaves its Playwright/Vite descendants running.\r\n        subprocess.run([shutil.which(\"taskkill\") or \"taskkill\", \"/PID\", str(process.pid), \"/T\", \"/F\"],\r\n            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)\r\n    else:\r\n        try:\r\n            os.killpg(process.pid, signal.SIGTERM)\r\n        except ProcessLookupError:\r\n            pass\r\n        try:\r\n            process.wait(timeout=5)\r\n        except subprocess.TimeoutExpired:\r\n            pass\r\n        # The parent can exit before a descendant; clean the remaining group too.\r\n        try:\r\n            os.killpg(process.pid, signal.SIGKILL)\r\n        except ProcessLookupError:\r\n            pass\r\n    if process.poll() is None:\r\n        process.kill()\r\n    process.wait(timeout=5)\r\n\r\n\r\ndef capture_process(command, *, cwd, timeout, env=None) -> dict:\r\n    \"\"\"Capture UTF-8 output and clean the whole process tree before re-raising timeout or Ctrl+C.\"\"\"\r\n    process = start_process(command, cwd=cwd, env=env, stdout=subprocess.PIPE,\r\n        stderr=subprocess.PIPE, text=True, encoding=\"utf-8\", errors=\"replace\")\r\n    try:\r\n        stdout, stderr = process.communicate(timeout=timeout)\r\n    except BaseException:\r\n        stop_process(process)\r\n        process.communicate(timeout=5)\r\n        raise\r\n    return {\"returncode\": process.returncode, \"stdout\": stdout,\r\n        \"output\": (stdout + stderr)[-24000:]}\r\n\r\n\r\ndef npm_command() -> list[str]:\r\n    \"\"\"Resolve npm through its JavaScript CLI, avoiding Windows .cmd shell quoting.\"\"\"\r\n    node, npm = shutil.which(\"node\"), shutil.which(\"npm\")\r\n    if not node or not npm:\r\n        raise ValueError(\"Node.js and npm are required; install them and add their executables to PATH\")\r\n    node = str(Path(node).resolve())\r\n    launcher = Path(npm).resolve()\r\n    if launcher.suffix.lower() in {\".js\", \".mjs\"}:\r\n        return [node, str(launcher)]\r\n    for directory in (launcher.parent, Path(node).resolve().parent):\r\n        script = directory / \"node_modules/npm/bin/npm-cli.js\"\r\n        if script.is_file():\r\n            return [node, str(script)]\r\n    if launcher.suffix.lower() in {\".cmd\", \".bat\", \".ps1\"}:\r\n        raise ValueError(\"Cannot locate npm-cli.js beside the npm/Node launcher; use a complete Node.js installation\")\r\n    # Unix installations may expose an executable script rather than a JS symlink.\r\n    return [str(launcher)]\r\n","exit_code":0,"status":"completed"}}
