ction.pragma(\"foreign_keys = OFF\");\r\n      connection.transaction(() => {\r\n        const tables = connection.prepare(\"SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'\").all() as { name: string }[];\r\n        for (const table of tables) connection.exec(`DELETE FROM \"${table.name.replaceAll('\"', '\"\"')}\"`);\r\n15:    \"\"\"Return a safe, stable E2E spec path for one requirement.\"\"\"\n20:    return f\"frontend/tests/e2e/{slug}.spec.ts\"\n39:        \"\"\"Compile UI and E2E tests, optionally restricting application sources during test generation.\"\"\"\n40:        return super().typecheck(files, test_roots=(\"frontend/tests/ui\", \"frontend/tests/e2e\"),\n43:    def tests(self, files):\n44:        \"\"\"Run only selected E2E specs with an owned temporary database, clean it up, .\"\"\"\n48:            if not (self.output / relative).resolve().is_relative_to(self.output / \"frontend/tests/e2e\"):\n","exit_code":0,"status":"completed"}}
